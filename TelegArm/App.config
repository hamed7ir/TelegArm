<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
    </startup>
    <runtime>
        <!-- Telegram is reachable only via a flaky VPN; a stray background exception (e.g. a faulted
             network task) must NOT terminate the process. Restore pre-4.0 behaviour: the unhandled-
             exception handler runs but the app keeps running instead of force-quitting. -->
        <legacyUnhandledExceptionPolicy enabled="1" />
        <!-- Deploy layout: managed dependency DLLs live in a "dll\" subfolder for a clean app root, so
             the CLR also probes <appbase>\dll for private assemblies. privatePath is a single relative
             subfolder and cannot escape the app base. NOTE: this covers MANAGED assemblies only, NOT native
             libs (libVLC, rlottie) and the data zips are located beside the exe by the app's own path
             logic (NativeLibraries / VlcEnvironment / EmojiRenderer) and MUST stay there, NOT in dll\. -->
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <probing privatePath="dll" />
        </assemblyBinding>
    </runtime>
</configuration>
