    <!-- Native rlottie (.tgs / Lottie). Per-arch; loaded by NativeLibraries.Init via SetDllDirectory. -->
    <Content Include="rlottie\ARM\rlottie.dll">
      <Link>rlottie\ARM\rlottie.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="rlottie\x86\rlottie.dll">
      <Link>rlottie\x86\rlottie.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Packed Noto Emoji (SIL OFL 1.1 — the LICENSE bundled inside the zip reads "Copyright 2013
         Google LLC ... SIL Open Font License, Version 1.1"; this comment said Apache-2.0 until
         BATCH-TA-2/L2 corrected it). One file replaces the loose Emoji\72x72 PNG folder;
         EmojiRenderer reads it once at startup. Lives at the repo root. -->
    <Content Include="..\noto-emoji.zip">
      <Link>noto-emoji.zip</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\img-icon\TelegArm.png">
      <Link>TelegArm.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 2026-10-16: media is FFmpeg (ffmpeg-rt 8.1.2) + TelegArm's tgav shim (native\tgav), per arch; loaded by
         Core\Media\Tgav from ffmpeg\<arch>\ (staged there by native\tgav\build.ps1). Replaced the libVLC zips. -->
    <Content Include="ffmpeg\ARM\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ffmpeg\x86\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 2026-10-16: Telegram calls (tgcalls + tg_owt) behind TelegArm's C ABI (native\tgcalls_native), per arch -->
    <Content Include="tgcalls\ARM\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tgcalls\x86\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Tray icons (unread-aware): swapped live by unread count. Repo root → copied beside the exe. -->
    <!-- Redesign 1.8 (DroidFinestra pattern): the multi-size app icon, embedded, for every window (AppIcon.Icon). -->
    <EmbeddedResource Include="..\img-icon\icon.ico">
      <Link>app.ico</Link>
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
    <Content Include="..\img-icon\trayicon.ico">
      <Link>trayicon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\img-icon\trayicon-unread.ico">
      <Link>trayicon-unread.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
