    </Content>
    <!-- Bundled libVLC runtimes (per-arch). Shipped as zips; VlcBootstrap extracts the matching-arch one
         to a libvlc/ folder on first run (LoadLibrary/plugins can't load from inside a zip). Repo root. -->
    <Content Include="..\libvlc-x86.zip">
      <Link>libvlc-x86.zip</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\libvlc-arm32.zip">
