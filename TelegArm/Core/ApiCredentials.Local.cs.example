//  2. Insert your own credentials from  https://my.telegram.org/apps
//
//  ApiCredentials.Local.cs is gitignored and must NEVER be committed. Without it the
//  app still builds (placeholders in ApiCredentials.cs take over) but will NOT
//  authenticate against Telegram.
// ─────────────────────────────────────────────────────────────────────────────
namespace TelegArm.Core
{
    public static partial class ApiCredentials
    {
        static partial void FillId(ref int value)      => value = 0;                          // ← your api_id  (integer)
        static partial void FillHash(ref string value) => value = "PUT_YOUR_API_HASH_HERE";   // ← your api_hash (32-char hex)
    }
}
